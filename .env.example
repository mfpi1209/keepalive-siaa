# Conexão Postgres (obrigatório)
DATABASE_URL=postgres://usuario:senha@host:5432/keepalive
# SSL do Postgres (opcional): "true" para conexões com TLS
DATABASE_SSL=false

# Token Bearer que protege as rotas /status, /schedule, /session, /alunos (obrigatório)
# Gere um aleatório: openssl rand -hex 20
AUTH_TOKEN=troque-por-um-token-aleatorio

# Porta HTTP (opcional, padrão 3000)
PORT=3000

# Valor inicial do intervalo (segundos) usado só na primeira criação da agenda (opcional)
INTERVAL_SEC=600

# Semear a sessão no boot a partir de uma cURL (opcional): um dos dois
# SIAA_CURL='curl https://siaa.cruzeirodosul.edu.br/...'
# CURL_FILE=/caminho/para/curl.txt
